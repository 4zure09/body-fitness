APP_ENV=local
HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
DATABASE_DSN=postgres://body_fitness:body_fitness@localhost:5432/body_fitness?sslmode=disable
# Railway injects DATABASE_URL into the API service through a reference variable.
# Never commit a real database URL or password.
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=30m
JWT_SECRET=local-development-secret-change-before-production-2026
JWT_ISSUER=body-fitness
JWT_AUDIENCE=body-fitness-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

